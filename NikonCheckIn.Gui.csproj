<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 仅构建 Windows 桌面（WinUI 3）窗口程序 -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>NikonCheckIn.Gui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- 显示名称 -->
		<ApplicationTitle>尼康自动签到</ApplicationTitle>

		<!-- 应用标识 -->
		<ApplicationId>com.lds7871.nikoncheckin.gui</ApplicationId>

		<!-- 版本 -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 非打包模式：直接以 exe 方式运行，便于本机调试与分发 -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<!-- 发布配置：自包含（目标机器无需预装 .NET 与 Windows App SDK） -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DebugType>embedded</DebugType>

		<!-- 文件夹发布：所有文件与 exe 同目录，运行时零解压、不写用户目录 -->
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>

	<!--
		只发布 Windows x64 的 node 运行时。
		Microsoft.Playwright 的 NuGet 包里带了 linux-x64 / linux-arm64 / darwin-x64 / darwin-arm64 / win32_x64
		五个平台的 node（合计约 516MB），另外四个用不到，排除掉可省约 437MB。
	-->
	<Target Name="TrimPlaywrightNodeRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
			                       Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('.playwright\node\')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('.playwright\node\win32_x64\'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- 应用图标（NK_ChickIn_icon.png，256x256 带透明通道） -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- 启动图 -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F2F4F7" BaseSize="128,128" />

		<!-- 图片 -->
		<MauiImage Include="Resources\Images\*" />

		<!-- 字体 -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- 原始资源 -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- 浏览器自动化（与原控制台版本保持一致） -->
		<PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 若已创建账号密码配置.txt，则复制到输出目录以便预填 -->
		<None Include="账号密码配置.txt" CopyToOutputDirectory="PreserveNewest"
		      Condition="Exists('账号密码配置.txt')" />
	</ItemGroup>

</Project>
