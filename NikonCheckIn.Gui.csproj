<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 仅构建 Windows 桌面（WinUI 3）窗口程序 -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>NikonCheckIn.Gui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- 显示名称 -->
		<ApplicationTitle>尼康自动签到</ApplicationTitle>

		<!-- 应用标识 -->
		<ApplicationId>com.lds7871.nikoncheckin.gui</ApplicationId>

		<!-- 版本 -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 非打包模式：直接以 exe 方式运行，便于本机调试与分发 -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- 应用图标 -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F6FED" />

		<!-- 启动图 -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F2F4F7" BaseSize="128,128" />

		<!-- 图片 -->
		<MauiImage Include="Resources\Images\*" />

		<!-- 字体 -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- 原始资源 -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- 浏览器自动化（与原控制台版本保持一致） -->
		<PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 若已创建账号密码配置.txt，则复制到输出目录以便预填 -->
		<None Include="账号密码配置.txt" CopyToOutputDirectory="PreserveNewest"
		      Condition="Exists('账号密码配置.txt')" />
	</ItemGroup>

</Project>
